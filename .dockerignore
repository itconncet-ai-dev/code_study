# Docker ignore file for AI Code Learning Platform
# Excludes files from Docker build context for faster builds

# Git
.git
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md
specs/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files (secrets)
.env
.env.*
!.env.example

# Python (backend)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node.js (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build artifacts
frontend/dist/
frontend/build/
backend/dist/

# Test files
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
**/__tests__/

# Logs
*.log
logs/

# Uploaded files (handled separately)
storage/uploads/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Temporary files
*.tmp
*.temp
tmp/
temp/
