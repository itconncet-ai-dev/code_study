# ============================================================================
# AI Code Learning Platform - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY WARNING: Never commit .env files to version control!
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment mode: development | staging | production
APP_ENV=development

# Enable debug mode (set to false in production)
DEBUG=true

# Secret key for general application security (generate a secure random string)
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# PostgreSQL connection settings (used by docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=code_learning
POSTGRES_PASSWORD=code_learning_dev
POSTGRES_DB=code_learning_db

# Full database URL (constructed from above values)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://code_learning:code_learning_dev@localhost:5432/code_learning_db

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis connection settings (used by docker-compose and Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Full Redis URL
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# JWT secret key (generate a secure random string, different from SECRET_KEY)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 15 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration in days (default: 7 days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# AI PROVIDER SELECTION
# ============================================================================

# AI provider to use: gemini | openrouter
# - gemini: Google Gemini API (requires GEMINI_API_KEY)
# - openrouter: OpenRouter API (requires OPENROUTER_API_KEY)
AI_PROVIDER=openrouter

# ============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ============================================================================

# Google Gemini API key (required if AI_PROVIDER=gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use (default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Request timeout in seconds
GEMINI_TIMEOUT=180

# Maximum retries for failed requests
GEMINI_MAX_RETRIES=3

# ============================================================================
# OPENROUTER AI CONFIGURATION
# ============================================================================

# OpenRouter API key (required if AI_PROVIDER=openrouter)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter model to use (default: openai/gpt-oss-120b:free)
# See available models: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request timeout in seconds
OPENROUTER_TIMEOUT=180

# Maximum retries for failed requests
OPENROUTER_MAX_RETRIES=3

# ============================================================================
# CELERY CONFIGURATION (Background Tasks)
# ============================================================================

# Celery broker URL (Redis)
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend URL (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Task time limit in seconds (default: 5 minutes)
CELERY_TASK_TIME_LIMIT=300

# ============================================================================
# FILE STORAGE
# ============================================================================

# Directory for uploaded code files (relative to project root)
UPLOAD_DIR=storage/uploads

# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
# In development: http://localhost:5173 (Vite default port)
# In production: your actual frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# BACKEND SERVER
# ============================================================================

# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================

# Backend API URL (used by frontend to make API calls)
VITE_API_URL=http://localhost:8000/api/v1

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# RATE LIMITING
# ============================================================================

# Authentication rate limit (attempts per window)
AUTH_RATE_LIMIT_ATTEMPTS=5

# Authentication rate limit window in minutes
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
